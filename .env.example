# ==============================================================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit your actual bot token or secrets to GitHub!
# Copy this file to .env and fill in your credentials.

# Discord Application Credentials (From https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Optional: Specific Guild ID for instant slash command testing during development
# If left blank, commands will register globally (can take up to a few minutes)
DEV_GUILD_ID=

# Server & Deployment Configuration
PORT=3000
NODE_ENV=production

# Database Adapter Selection ('json', 'sqlite', 'postgres', or 'supabase')
DB_TYPE=json
DB_PATH=./data/database.json

# PostgreSQL / Supabase connection string (used only if DB_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Logging Level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=info

# Default Channels Configuration (Optional: Can also be set per-server via /setwelcome, /setlogs, /setcommands)
# Provide either the Channel Snowflake ID or the exact Channel Name (e.g. ᴡᴇʟᴄᴏᴍᴇ, 📋・logs, bot-commands)
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
COMMANDS_CHANNEL_ID=
